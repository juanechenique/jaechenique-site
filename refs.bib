@misc{blanchflowerConsequencesAbuseNeglect2024,
  type = {Working {{Paper}}},
  title = {The {{Consequences}} of {{Abuse}}, {{Neglect}} and {{Cyber}}-Bullying on the {{Wellbeing}} of the {{Young}}},
  author = {Blanchflower, David G. and Bryson, Alex},
  year = 2024,
  month = feb,
  series = {Working {{Paper Series}}},
  number = {32119},
  eprint = {32119},
  publisher = {National Bureau of Economic Research},
  doi = {10.3386/w32119},
  urldate = {2024-02-06},
  abstract = {Using cross-sectional data files for the United States we show that difficulties experienced in childhood - so-called Adverse Child Experiences (ACE)s - are strongly and significantly associated with mental health in adulthood. Our evidence is taken from eight Behavioral Risk Factor Surveillance System (BRFSS) surveys from 2009-2023 which contain a special supplement asking respondents to recall abuse in their childhood. We find that poor mental health is on the rise in the United States, particularly among young women. This upward trend among the young is also apparent from the National Health Interview Surveys 1997-2021, the Healthy Minds surveys of 2007-2023 and the Youth Risk Behavior Surveillance System (YRBSS) for high school students. We find ACEs are strongly correlated with poor mental health among both the young and older people and the effect is additive. The impact of living with a household member with poor mental health is large relative to other ACEs and is particularly pronounced among younger people. Being bullied, including electronically, is also strongly negatively associated with the wellbeing of high school students. Time spent in front of a screen has been rising over time for the young and has an independent negative impact on their mental health over and above bullying, one which is more pronounced for young women.},
  archiveprefix = {National Bureau of Economic Research},
  file = {/Users/echenj01/Zotero/storage/UR98TXME/Blanchflower and Bryson - 2024 - The Consequences of Abuse, Neglect and Cyber-bully.pdf}
}

@article{blancoOpportunitiesNeedsAdvance2025,
  title = {Opportunities and {{Needs}} to {{Advance Prevention}} of {{Substance Use Disorders}}},
  author = {Blanco, Carlos and Volkow, Nora D.},
  year = 2025,
  month = may,
  journal = {JAMA Pediatrics},
  volume = {179},
  number = {5},
  pages = {487--488},
  issn = {2168-6203},
  doi = {10.1001/jamapediatrics.2025.0007},
  urldate = {2025-05-06},
  abstract = {Overdose deaths among US youth have continued to rise despite expanded access to medications for opioid use disorder and overdose reversal. The importance of prevention for addressing this crisis is clear, yet, to date, few preventive interventions have been developed or deployed. We highlight 4 areas of opportunity to strengthen prevention efforts.First, there is a need to improve the prevention delivery system. Demonstration of intervention efficacy in research studies (ie, becoming an evidence-based preventive intervention [EBPI]) seldom translates into the intervention's implementation, even when cost-effective, as there is rarely dedicated funding for these programs. Although several federal and state agencies fund limited areas of prevention, the US lacks a stable, consistently funded prevention infrastructure, including a well-trained workforce, to deliver EBPIs. To address these challenges, in July 2023, the National Institutes of Health (NIH), Substance Abuse and Mental Health Services Administration, and US Centers for Disease Control and Prevention commissioned a consensus study from the National Academies of Sciences, Engineering, and Medicine to identify (1) best practices for creating a sustainable behavioral health disorder prevention infrastructure (including funding), and (2) research gaps germane to the widespread adoption of EBPIs. The study publication is expected in spring 2025 and will provide recommendations to leaders of public and private health systems as well as payers on how to build and sustain this infrastructure and whether it should build on existing structures, such as primary care, schools, the justice system, or child welfare. A scalable, sustainable prevention infrastructure could save hundreds of thousands of lives in the US and become a model for other countries.},
  file = {/Users/echenj01/Zotero/storage/SL4M2GEU/2830770.html}
}

