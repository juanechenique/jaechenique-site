@misc{guiLastMileFirst2025,
  type = {{{SSRN Scholarly Paper}}},
  title = {The {{Last Mile}} to {{First Treatment}}: {{Searching}} for {{Opioid Use Disorder Medication}}},
  shorttitle = {The {{Last Mile}} to {{First Treatment}}},
