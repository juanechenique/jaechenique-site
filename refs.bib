@article{wuTabletPCApplicationIndividual2007,
  title = {A Tablet-{{PC}} Application for the Individual Family Service Plan ({{IFSP}})},
  author = {Wu, Min and Rhyner, Paula M. and Thao, Cheng and Kraniak, Liz and Cronk, Christine and Cruise, Katie},
