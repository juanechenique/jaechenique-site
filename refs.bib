@article{miechDeclinesAdolescentSubstance2023,
  title = {Declines in {{Adolescent Substance Use After}} the {{COVID-19 Pandemic Onset}}: {{The Role}} of {{Initiation}} in {{Grades}} 7 and 9},
  shorttitle = {Declines in {{Adolescent Substance Use After}} the {{COVID-19 Pandemic Onset}}},
  author = {Miech, Richard and Patrick, Megan E. and Keyes, Katherine},
  year = 2023,
  month = nov,
  journal = {Journal of Adolescent Health},
  volume = {73},
  number = {5},
  pages = {838--844},
  issn = {1054139X},
  doi = {10.1016/j.jadohealth.2023.05.033},
  urldate = {2026-01-15},
  abstract = {Purpose: To examine if the record declines in adolescent substance use after onset of the COVID-19 pandemic resulted from reduced levels of initiation, defined as any lifetime use. Methods: We analyzed data from the nationally-representative, cross-sectional, annual Monitoring the Futures surveys of 8th, 10th, and 12th grade students from 2019-2022. Measures included past 12-month use of cannabis, nicotine vaping, and alcohol, as well self-reported reported grade of initiation of each substance. Analyses are based on randomly-selected subsamples of students who received questions on both prevalence and grade of first use, resulting in a total sample size of 96,990 students. Results: Levels of past 12-month substance use were markedly lower after the onset of the pandemic, in 2021 and 2022. In 8th and 10th grade, levels were at least one-third lower for cannabis and nicotine vaping, and 13\% to 31\% lower for alcohol. In 12th grade, the decreases ranged from 9\% to 23\%. Lower levels of initiation in 7th grade in 2020/2021 accounted for half or more of the overall prevalence decreases in 8th grade in 2021/2022. Lower levels of initiation in 9th grade in 2020/2021 accounted for 45\% or more of the overall prevalence decreases in 10th grade in 2021/2022. Declines in 12th grade substance use prevalence were not consistently linked to lower initiation in earlier grades. Conclusions: Much of the declines in overall prevalence of adolescent substance use after the onset of the COVID-19 pandemic trace back specifically to declines in substance use initiation in 7th and 9th grades.},
  langid = {english},
  file = {/Users/echenj01/Zotero/storage/QJC6BMH9/Miech et al. - 2023 - Declines in Adolescent Substance Use After the COVID-19 Pandemic Onset The Role of Initiation in Gr.pdf}
}

