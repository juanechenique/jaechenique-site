@article{mceachernLackingEvidenceAssociation2019,
  title = {Lacking Evidence for the Association between Frequent Urine Drug Screening and Health Outcomes of Persons on Opioid Agonist Therapy},
  author = {McEachern, Jasmine and {Adye-White}, Lauren and Priest, Kelsey C. and Moss, Eloise and Gorfinkel, Lauren and Wood, Evan and Cullen, Walter and Klimas, Jan},
  year = 2019,
