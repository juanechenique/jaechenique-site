@article{callisonHigherTobaccoTaxes2014,
  title = {Do {{Higher Tobacco Taxes Reduce Adult Smoking}}? {{New Evidence}} of the {{Effect}} of {{Recent Cigarette Tax Increases}} on {{Adult Smoking}}},
  shorttitle = {Do {{Higher Tobacco Taxes Reduce Adult Smoking}}?},
  author = {Callison, Kevin and Kaestner, Robert},
  year = 2014,
  journal = {Economic Inquiry},
