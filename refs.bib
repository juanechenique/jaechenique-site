@article{hogueRelationshipOrientedRecoverySystem2023,
  title = {Relationship-{{Oriented Recovery System}} for {{Youth}} ({{RORSY}}): {{Clinical Protocol}} for {{Transition-Age Youth}} with {{Opioid Use Disorders}}},
  shorttitle = {Relationship-{{Oriented Recovery System}} for {{Youth}} ({{RORSY}})},
  author = {Hogue, Aaron and Bobek, Molly and MacLean, Alexandra and Schumm, Jeremiah A and Wenzel, Kevin and Fishman, Marc},
