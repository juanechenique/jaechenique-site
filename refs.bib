  doi = {10.1086/431258},
  abstract = {The associations between family background and child development were studied. Questions which relate to: (1) whether correlates of early child development (ECD) including family background are proxying for other variables in usual estimates, such as health programmes; and (2) whether there are interactions between family background and other variables or among the family background variables, were studied. Rich new data collected from the Philippines were used to examine the above questions; the data included indicators of ECD for 3556 Filipino preschool children aged 0-36 months (cognitive, social and motor development; anthropometrics; haemoglobin measurements; and occurrence of helminths); and family background (educational attainment and anthropometrics for both mothers and fathers). The results indicate that family background has a number of positive effects on ECD in the Philippines. Examples of such relationships include those between the family's physical assets and the haemoglobin levels, height-for-age, weight-for-age and occurrence of helminths among children. No evidence of widespread interactions between family background and health services that affect ECD was found. Also, the results showed that failure to account for community characteristics can give misleading indications of the probable impact of family background on ECD.},
  file = {/Users/echenj01/Zotero/storage/F45K749N/Ghuman et al. - 2005 - Family Background, Service Providers, and Early Childhood Development in the Philippines Proxies and Interactions.pdf}
}

@article{gillReasonsAdmissionsUS2021,
