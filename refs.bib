  shorttitle = {Towards a Youth Mental Health Paradigm},
  author = {Uhlhaas, Peter J. and Davey, Christopher G. and Mehta, Urvakhsh Meherwan and Shah, Jai and Torous, John and Allen, Nicholas B. and Avenevoli, Shelli and {Bella-Awusah}, Tolulope and Chanen, Andrew and Chen, Eric Y. H. and Correll, Christoph U. and Do, Kim Q. and Fisher, Helen L. and Frangou, Sophia and Hickie, Ian B. and Keshavan, Matcheri S. and Konrad, Kerstin and Lee, Francis S. and Liu, Cindy H. and Luna, Beatriz and McGorry, Patrick D. and {Meyer-Lindenberg}, Andreas and Nordentoft, Merete and {\"O}ng{\"u}r, Dost and Patton, George C. and Paus, Tom{\'a}{\v s} and Reininghaus, Ulrich and Sawa, Akira and Schoenbaum, Michael and Schumann, Gunter and Srihari, Vinod H. and Susser, Ezra and Verma, Swapna K. and Woo, T. Wilson and Yang, Lawrence H. and Yung, Alison R. and Wood, Stephen J.},
