  author = {Helensdotter, Ronja},
  abstract = {This paper studies the effects of the court-ordered removal of children from home on health. To isolate causal effects, I exploit quasi-random variation in judge assignment together with across-judge variation in the tendency to favor removal in an instrumental variable (IV) design. Using a novel data set based on court documents that I transcribe and link with detailed register data, I find that involuntary out-of-home placement has large adverse effects on the mortality of the marginal child. These effects are primarily driven by suicides that occur while the removed child is still placed in out-of-home care. Removal also causes an increase in crimes committed by youths and birth parents against persons (e.g., violent and sexual crimes). There is little evidence of adverse health effects for birth parents.},
