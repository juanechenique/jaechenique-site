@article{markMedicaidCoverageMedications2015,
  title = {Medicaid Coverage of Medications to Treat Alcohol and Opioid Dependence},
  author = {Mark, Tami L. and Lubran, Robert and {McCance-Katz}, Elinore F. and Chalk, Mady and Richardson, John},
  year = 2015,
  month = aug,
  journal = {Journal of Substance Abuse Treatment},
  volume = {55},
  pages = {1--5},
  issn = {1873-6483},
  doi = {10.1016/j.jsat.2015.04.009},
  abstract = {Substance use disorders affect 12\% of Medicaid beneficiaries. The prescription drug epidemic and growing need for treatment of alcohol and opioid dependence have refocused states' attention on their provision of substance use disorder treatment services, including medications. This study characterized how Medicaid programs cover these treatment medications. Data were from 2013 Medicaid pharmacy documents, 2011 and 2012 Medicaid state drug utilization records, and a 2013 American Society of Addiction Medicine survey. Results showed that only 13 state Medicaid programs included all medications approved for alcohol and opioid dependence on their preferred drug lists. The most commonly excluded were extended-release naltrexone (19 programs), acamprosate (19 programs), and methadone (20 programs). For combined buprenorphine-naloxone, 48 Medicaid programs required prior authorization, and 11 programs used 1- to 3-year lifetime treatment limits. Given the chronic nature of substance use disorders and the overwhelming evidence supporting ongoing coverage for many of these medications, states may want to reexamine substance use disorder benefits.},
  langid = {english},
  pmid = {25921475},
  keywords = {Acamprosate,Alcohol,Alcohol Deterrents,Alcohol-Related Disorders,Buprenorphine Naloxone Drug Combination,Financing health care,Humans,Insurance coverage,Insurance Coverage,Lifetime treatment limits,Medicaid,Methadone,Naltrexone,Narcotic Antagonists,Narcotics,Opioid,Opioid-Related Disorders,Preferred drug lists,Taurine,United States},
  file = {/Users/echenj01/Zotero/storage/LN6NQH9Z/Mark et al. - 2015 - Medicaid coverage of medications to treat alcohol and opioid dependence.pdf}
}

@book{markTrackingQualityAddiction2020,
