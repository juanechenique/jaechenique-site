@article{andresSanitationExternalitiesEvidence2017,
  title = {Sanitation and Externalities: Evidence from Early Childhood Health in Rural {{India}}},
  author = {Andr{\'e}s, Luis and Brice{\~n}o, Bertha and Chase, Claire and Echenique, Juan A.},
  year = 2017,
  journal = {Journal of Water Sanitation and Hygiene for Development},
  volume = {7},
  number = {2},
  pages = {272--289},
  doi = {10.2166/washdev.2017.143},
  abstract = {This paper estimates two sources of benefits related to sanitation infrastructure access: a direct benefit households receive when they have access to sanitation infrastructure, and an external benefit produced by the neighborhood's access to sanitation infrastructure. Using a sample of children under age four from rural areas of India in the Third Round of District Level Household Survey 2007--08, the study demonstrates evidence of positive direct benefits and a concave positive externality for improved sanitation and fixed-point defecation. The paper finds that a child who moves from a household without improved sanitation and a low ratio of village access to a household with improved sanitation and a high ratio of village access enjoys a reduction in diarrhea prevalence of 47 percent. From this, one-fourth of this benefit is due to the direct benefit, leaving the rest to external gains. These results hold under several robustness checks.},
  keywords = {corresponding author,luis andres},
  file = {/Users/echenj01/Zotero/storage/D5EEQ8SG/Andres et al. - Sanitation and Externalities Evidence from Early .pdf;/Users/echenj01/Zotero/storage/JXEJ8SPH/Andrés et al. - 2017 - Sanitation and externalities evidence from early .pdf;/Users/echenj01/Zotero/storage/LVL6R5WI/Andrés et al. - 2017 - Sanitation and externalities evidence from early childhood health in rural India.pdf;/Users/echenj01/Zotero/storage/PYDVIGX2/Sanitation-and-externalities-evidence-from-early.html}
}

