@article{farahmandSchoolBasedMentalHealth2011,
  title = {School-{{Based Mental Health}} and {{Behavioral Programs}} for {{Low-Income}}, {{Urban Youth}}: {{A Systematic}} and {{Meta-Analytic Review}}},
  shorttitle = {School-{{Based Mental Health}} and {{Behavioral Programs}} for {{Low-Income}}, {{Urban Youth}}},
  author = {Farahmand, Farahnaz K. and Grant, Kathryn E. and Polo, Antonio J. and Duffy, Sophia N.},
