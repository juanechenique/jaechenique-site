@article{blecherTaxesTobaccoAlcohol2015,
  title = {Taxes on Tobacco, Alcohol and Sugar Sweetened Beverages: {{Linkages}} and Lessons Learned},
  shorttitle = {Taxes on Tobacco, Alcohol and Sugar Sweetened Beverages},
  author = {Blecher, Evan},
  year = 2015,
  month = jul,
  journal = {Social Science \& Medicine},
  volume = {136--137},
  pages = {175--179},
  issn = {0277-9536},
  doi = {10.1016/j.socscimed.2015.05.022},
  urldate = {2024-09-27},
  abstract = {Increased consumption of sugar-sweetened beverages (SSBs) has been linked to increases in obesity in both high-income and low- and middle-income countries. Tobacco and alcohol taxes have proven to be effective tools to reduce tobacco and alcohol use. Many public health advocates propose using similar taxes to reduce consumption of SSBs. South Africa is a middle-income country that is considered a leader in the area of tobacco tax policy. A case study of tobacco and alcohol taxes is used to better understand optimal tax structures for SSBs. The case study tracks aggregate data over time on taxes, prices, consumption, tax revenues, and marketing expenditures at the brand level. Tobacco and alcohol taxes are shown to be effective in reducing the demand for tobacco. Additionally, taxes on the dose of alcohol rather than the volume of the beverage may incentivize producers to reduce the volume of alcohol in beverages through the supply side. While specific taxes based on the volume of beverages are likely to reduce the demand for SSBs, policy makers should also consider taxes on alcohol and SSBs that tax the dose of the alcohol and calories in order to create supply-side incentives for producers to lower alcohol and calorie levels in existing products or promote products with lower levels of alcohol and calories.},
  keywords = {Alcohol,South Africa,Sugar-sweetened beverages,Tax,Tobacco},
  file = {/Users/echenj01/Zotero/storage/8H5MFIZU/S0277953615003044.html}
}

