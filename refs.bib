@article{walshImplementingLEARNComprehensive2024,
  title = {Implementing {{LEARN}}: {{Comprehensive Suicide Prevention Training}} for {{High School Students}}, {{Parents}}, and {{School Personnel}}},
  shorttitle = {Implementing {{LEARN}}},
  author = {Walsh, Elaine and Tapp, Zoe and Mallonee, Emma and Hakansson, Camille and Leigh, Ambyr and Reibel, Megan},
  year = 2024,
  month = nov,
  journal = {The Journal of School Health},
  volume = {94},
  number = {11},
  pages = {1040--1048},
  issn = {1746-1561},
  doi = {10.1111/josh.13516},
  abstract = {BACKGROUND: Adolescent suicide is a public health issue, and school is an ideal setting for prevention activities. LEARN is a peer-led gatekeeper training for high school personnel, parents, and students. The purpose of this study was to evaluate the effectiveness of LEARN as a gatekeeper training. METHODS: Paired t tests were used to compare pre- and post-training surveys for 4983 LEARN participants. RESULTS: Participants reported an increased likelihood of engaging in each LEARN step: looking for signs, empathizing and listening, asking about suicide thoughts and plans, reducing danger, and connecting the person with help. Most participants were highly satisfied with the peer trainer's delivery of content. CONCLUSIONS: LEARN gatekeeper training was successfully implemented in high schools with students, parents, and school personnel. All groups reported increases in likelihood of approaching and providing support and connections for at-risk individuals and rated the trainer as effective, indicating satisfaction with the peer-led training format.},
  langid = {english},
  pmid = {39449297},
  keywords = {adolescence,Adolescent,Female,gatekeeper training,high school,Humans,Male,Parents,Peer Group,School Health Services,school programming,Schools,Students,suicide prevention,Suicide Prevention},
