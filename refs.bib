  title = {Strategies to Avoid the Loss of Developmental Potential in More than 200 Million Children in the Developing World},
  author = {Engle, Patrice L. and Black, Maureen M. and Behrman, Jere R. and {Cabral de Mello}, Meena and Gertler, Paul J. and Kapiriri, Lydia and Martorell, Reynaldo and Young, Mary Eming},
  year = 2007,
  journal = {Lancet},
  volume = {369},
