@article{clarkeSyntheticDifferenceinDifferencesRelated,
  title = {On {{Synthetic Difference}}-in-{{Differences}} and {{Related Estimation Methods}} in {{Stata}}},
  author = {Clarke, Damian and Pailanir, Daniel and Athey, Susan and Imbens, Guido},
  abstract = {In this paper, we describe a computational implementation of the Synthetic difference-in-differences (SDID) estimator of Arkhangelsky et al. (2021) for Stata. Synthetic difference-in-differences can be used in a wide class of circumstances where treatment effects on some particular policy or event are desired, and repeated observations on treated and untreated units are available over time. We lay out the theory underlying SDID, both when there is a single treatment adoption date and when adoption is staggered over time, and discuss estimation and inference in each of these cases. We introduce the sdid command which implements these methods in Stata, and provide a number of examples of use, discussing estimation, inference, and visualization of results. Along with SDID, the sdid command allows for the implementation of standard synthetic control and difference-in-differences methods in an identical framework, permitting estimation, inference, and the generation of graphical output in a computationally efficient way.},
  langid = {english},
  file = {/Users/echenj01/Zotero/storage/7IM962D5/Clarke et al. - On Synthetic Difference-in-Differences and Related.pdf}
}

