}

@article{jacksonSchoolEffectsSocioemotional2020,
  title = {School {{Effects}} on {{Socioemotional Development}}, {{School-Based Arrests}}, and {{Educational Attainment}}},
  author = {Jackson, C. Kirabo and Porter, Shanette C. and Easton, John Q. and Blanchard, Alyssa and Kiguel, Sebasti{\'a}n},
