@article{paniagua-avilaIntegratedProgramsCommon2025,
  title = {Integrated Programs for Common Mental Illnesses within Primary Care and Community Settings in {{Latin America}}: A Scoping Review of Components and Implementation Strategies},
  shorttitle = {Integrated Programs for Common Mental Illnesses within Primary Care and Community Settings in {{Latin America}}},
  author = {{Paniagua-Avila}, Alejandra and Branas, Charles and Susser, Ezra and Fort, Meredith P. and Shelton, Rachel and Trigueros, Lourdes and Camara, Barbara and Costigan, Elen and Demis, Lina and Florence, Ana and Flores, Maria and {Miller-Suchet}, Lucy and {Paredes-Montero}, Angela and Rodrigues, Mariana and Kane, Jeremy},
