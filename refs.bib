@article{adamsEstimatedPrevalenceSubstance2025,
  title = {Estimated {{Prevalence}} of {{Substance Use Disorders Among US Adolescents}} and {{Emerging Adults}} by {{Substance Class}}, {{Severity}}, and {{Age}}, 2022},
  author = {Adams, Zachary W. and Dellucci, Trey V. and Agley, Jon and Bixler, Kristina and Sullivan, Maggie and Hinckley, Jesse D. and Hulvershorn, Leslie A.},
  year = 2025,
  month = dec,
  journal = {JAACAP Open},
  volume = {3},
  number = {4},
  pages = {959--971},
  issn = {29497329},
  doi = {10.1016/j.jaacop.2025.01.002},
  urldate = {2026-02-10},
  abstract = {Objective: Substance use disorders (SUDs) often develop during adolescence, forecasting myriad health problems across the lifespan. Implementing responsive clinical services requires information about the prevalence of SUDs by age, substance class, and severity. However, no reports have summarized those data using DSM-5 criteria. Method: Using 2022 National Survey on Drug Use and Health (NSDUH) data from participants 12 to 25 years of age (n {$\frac{1}{4}$} 26,276), the prevalence and severity of DSM-5 SUDs was estimated across age cohorts (12-13, 14-15, 16-17, 18-20, and 21-25 years) via c2 tests of independence. The Cramer V (4c) was also calculated for each outcome to approximate the effect size between age group and substance use outcome. Results: Although past-year rates for alcohol and cannabis use were higher overall as age cohort increased, the prevalence of disordered use and proportional distribution of SUD severity (mild, moderate, severe) did not differ across age cohorts among those who used alcohol (4c {$\frac{1}{4}$} 0.04) and cannabis (4c {$\frac{1}{4}$} 0.04) in the past year. Conversely, the prevalence and severity of SUDs generally varied across age groups among those who reported past-year use of less commonly used substances (heroin, methamphetamine). Conclusion: Meeting criteria for an SUD was common among youth with past-year substance use. Allocation of developmentally appropriate prevention and treatment resources should account for the distribution of mild to severe SUDs across adolescence. The field would likely benefit from further study of these issues in diverse samples.},
  langid = {english},
  file = {/Users/echenj01/Zotero/storage/GCIFQ7QZ/Adams et al. - 2025 - Estimated Prevalence of Substance Use Disorders Among US Adolescents and Emerging Adults by Substanc.pdf}
}

@article{adiseLimitationsBMIScores2024,
