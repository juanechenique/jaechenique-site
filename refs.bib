@article{bakerDeterminantsEmergencyDepartment1996,
  title = {Determinants of {{Emergency Department Use}}: {{Are Race}} and {{Ethnicity Important}}?},
  shorttitle = {Determinants of {{Emergency Department Use}}},
  author = {Baker, David W and Stevens, Carl D and Brook, Robert H},
  year = 1996,
