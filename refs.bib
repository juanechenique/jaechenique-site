@article{husseyDesignAnalysisStepped2007,
  title = {Design and Analysis of Stepped Wedge Cluster Randomized Trials},
  author = {Hussey, Michael A. and Hughes, James P.},
  year = 2007,
  month = feb,
  journal = {Contemporary Clinical Trials},
  volume = {28},
