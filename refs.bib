@article{batollaEffectsSanitationInfant,
  title = {The {{Effects}} of {{Sanitation}} on {{Infant Health}}: {{Evidence}} from {{Brazil}}},
  author = {Batolla, Fernanda and Mata, Daniel Da and Oliveira, Pedro},
  abstract = {Safely managed sanitation has been recognized as one of the most significant advancements in public health over the past few centuries. However, more recent sanitation interventions in low- and middle-income countries have not consistently achieved the expected health benefits. Using individual-level administrative data, we examine the impact of a large-scale expansion in sanitation on birth outcomes in Brazil. Our empirical strategy leverages variation in the timing of sanitation improvements, comparing pregnant women in the same location but exposed at different stages of pregnancy. We show that exposure to sanitation during early pregnancy increases birth weight and enhances overall newborn health. Our results reveal heterogeneous effects, with more vulnerable mothers benefiting less from the intervention. Further analysis suggests that these differences arise from limited adoption by vulnerable households due to unaffordable sanitation bills or installation costs. Our findings highlight the importance of improving the ``last-mile'' delivery and increasing final users' takeup to maximize the benefits of improved sanitation infrastructure in low- and middle-income countries.},
  langid = {english},
  file = {/Users/echenj01/Zotero/storage/8WTHMKRQ/Batolla et al. - The Effects of Sanitation on Infant Health Evidence from Brazil.pdf}
}

