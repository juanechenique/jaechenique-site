@article{reesAntiBullyingLawsSuicidal2022,
  title = {Anti-{{Bullying Laws}} and {{Suicidal Behaviors Among Teenagers}}},
  author = {Rees, Daniel I. and Sabia, Joseph J. and Kumpas, Gokhan},
