}

@article{bollingerLocalExciseTaxes2023,
  title = {Local Excise Taxes, Sticky Prices, and Spillovers: Evidence from {{Berkeley}}'s Soda Tax},
  shorttitle = {Local Excise Taxes, Sticky Prices, and Spillovers},
  author = {Bollinger, Bryan and Sexton, Steven E.},
  year = 2023,
  month = jun,
  journal = {Quantitative Marketing and Economics},
  volume = {21},
  number = {2},
  pages = {281--331},
  issn = {1573-711X},
  doi = {10.1007/s11129-023-09263-y},
  urldate = {2023-12-22},
  abstract = {This paper evaluates the price and consumption effects of the first municipal soda tax imposed in the United States. Using high-resolution scanner data and data-driven approaches to select comparison units for counterfactual analysis, we estimate the tax has no effect on prices or consumption at drugstores, but increases supermarket prices of some soda products, constituting a minority of soda consumption. We estimate UPC-level pass through rates and find that there is significant heterogeneity across UPCs, much of which is explained by brand and size; average UPC-level pass through estimates in the supermarket range between 19\% and 23\%. We find limited evidence of reduced supermarket purchases of soda in the taxed jurisdiction. Half of these reduced purchases are substituted to just outside the taxed jurisdiction. Retailers' limited price responses are attributed to the localness of the tax; other research studying the Philadelphia soda tax has demonstrated more substantial pass-through in this much larger jurisdiction.},
  langid = {english},
  keywords = {Consumer demand,H22,H71,I18,L11,L66,M38,Pass-through,Policy evaluation,Pricing,Sin taxes},
  file = {/Users/echenj01/Zotero/storage/EX3UPMPD/Bollinger and Sexton - 2023 - Local excise taxes, sticky prices, and spillovers.pdf}
}

