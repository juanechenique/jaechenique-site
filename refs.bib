@article{druryAgeTransitionAge2026,
  title = {Beyond {{Age}}: {{Transition Age Adults Have Distinct Identities}}, {{Substance Use Patterns Compared With Other Adults}} in {{Substance Use Disorder Treatment}}},
  shorttitle = {Beyond {{Age}}},
  author = {Drury, Vanessa and Aleksanyan, Josh and Narayanan, Nithya and Echenique, Juan and Melkonian, Matilda and Renteria, Diego and Fawole, Adetayo and Choi, Sugy and Kawola, Sam and {del Rosario}, Jamie and Lincourt, Pat and Morris, Maria L. and Neighbors, Charles J. and Cunningham, Chinazo O. and Jordan, Ashly E.},
  year = 2026,
  month = apr,
  journal = {Journal of Addiction Medicine},
  pages = {10.1097/ADM.0000000000001692},
  issn = {1932-0620},
  doi = {10.1097/ADM.0000000000001692},
  urldate = {2026-04-30},
  abstract = {Objectives:~           Transition age (TA, 18--5 years old) adults experience disproportionately high rates of substance use disorders (SUD) but are less likely than other adults to engage in treatment. To better understand TA adults engaged in SUD treatment, we explored the characteristics of this age group compared with other adults 26 years or older.           Methods:~           Using New York State administrative data, we compared sociodemographic characteristics and substance use patterns of TA adults and other adults ({$\geq$}26 years) in SUD treatment in 2023 at the individual level, overall and stratified by specific SUD (alcohol, cannabis, opioid, stimulant, or sedative use disorder). Two-sample proportion tests by age group were conducted, and prevalence ratios (PR) were calculated. Effect size was determined with Cohen's h.           Results:~           TA adults accounted for 8.1\% (N = 12,103) of adults engaged in SUD treatment in 2023 (N = 148,611). Compared with other adults, TA adults were significantly more likely to identify as LGBT (11.7\% vs 5.6\%, p {$<$} 0.01, h = 0.22), report criminal legal system involvement (46.2\% vs 33.3\%, p {$<$} 0.01, h = 0.27), and be engaged for cannabis use disorder (32.8\% vs 7.4\%, p {$<$} 0.01, h = 0.67). Compared with other adults, they were significantly less likely to be unstably housed (15.6\% vs 24.3\% p {$<$} 0.01, h = -0.22) and engaged in opioid use disorder (20.0\% vs 37.5\%, p {$<$} 0.01, h = -0.39).           Conclusions:~           TA adults in SUD treatment have distinct identities and substance use patterns compared with other adults in SUD treatment. These characteristics can inform age-specific treatment programs and guide resource allocation, outreach, and engagement strategies.},
  langid = {american},
  file = {/Users/echenj01/Zotero/storage/CZ486FGJ/beyond_age__transition_age_adults_have_distinct.694.html}
}

@article{drussEvidenceBasedPracticingMental2025,
  title = {Evidence-{{Based Practicing}} in {{Mental Health}}},
  author = {Druss, Benjamin G. and Jones, Nev},
  year = 2025,
  month = may,
  journal = {JAMA Psychiatry},
  volume = {82},
  number = {5},
  pages = {433--434},
  issn = {2168-622X},
  doi = {10.1001/jamapsychiatry.2025.0010},
  urldate = {2025-05-08},
  abstract = {The evidence-based medicine (EBM) movement emerged in the early 1990s with an ambitious goal: to replace an approach to care based on authority and unsystematic clinical experience (``expert-based medicine'') with one incorporating the best possible evidence in real time during clinical encounters. In mental health, the evidence-based practice framework sought to apply the principles of EBM to behavioral health care. Both of these models described a ``3-legged stool,'' in which clinical care rests on an optimal balance between clinical expertise, research evidence, and the values, preferences, and characteristics of service users.}
}

