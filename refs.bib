  keywords = {adolescents,children,psychopathology,residential,treatment},
  file = {/Users/echenj01/Zotero/storage/LB3HRV8I/Connor et al. - 2004 - Characteristics of Children and Adolescents Admitted to a Residential Treatment Center.pdf}
