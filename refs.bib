@article{ghumanFamilyBackgroundService2005,
  title = {Family {{Background}}, {{Service Providers}}, and {{Early Childhood Development}} in the {{Philippines}}: {{Proxies}} and {{Interactions}}},
  author = {Ghuman, Sharon and Behrman, Jere~R. and Borja, Judith~B. and Gultiano, Socorro and King, Elizabeth~M.},
