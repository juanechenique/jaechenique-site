  pages = {22--49},
  issn = {0022-2437, 1547-7193},
  doi = {10.1177/0022243720969401},
  urldate = {2022-11-08},
  abstract = {The authors analyze the impact of a tax on sweetened beverages using a unique data set of prices, quantities sold, and nutritional information across several thousand taxed and untaxed beverages for a large set of stores in Philadelphia and its surrounding area. The tax is passed through at an average rate of 97\%, leading to a 34\% price increase. Demand in the taxed area decreases by 46\% in response to the tax. Cross-shopping to stores outside of Philadelphia offsets more than half of the reduction in sales in the city and decreases the net reduction in sales of taxed beverages to only 22\%. There is no significant substitution to bottled water and modest substitution to untaxed natural juices. The authors show that tax avoidance through cross-shopping severely constrains revenue generation and nutritional improvement, thus making geographic coverage an important policy decision.},
