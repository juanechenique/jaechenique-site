@article{marcotteEconomicsSuicideRevisited2003,
  title = {The {{Economics}} of {{Suicide}}, {{Revisited}}},
  author = {Marcotte, Dave E.},
  year = 2003,
  journal = {Southern Economic Journal},
  volume = {69},
  number = {3},
