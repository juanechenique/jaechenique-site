@article{cariseIdentifyingUnitedStates2005,
  title = {Identifying {{United States Substance Abuse Treatment Programs}}: {{A Test}} in {{One Mid-Sized City}}},
  shorttitle = {Identifying {{United States Substance Abuse Treatment Programs}}},
  author = {Carise, Deni and McLellan, A. Thomas and Festinger, David S. and Kleber, Herbert D.},
  year = 2005,
