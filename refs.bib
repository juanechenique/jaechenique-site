  author = {Hayes, Michael S and Gershenson, Seth},
  year = 2013,
  pages = {46--46},
  doi = {10.1177/0895904815625288},
  abstract = {Value-added models (VAMs) that use lagged test scores to proxy for unobserved historical inputs are becoming an increasingly popular tool for evaluating teacher effectiveness in states and districts across the United States. In practice, VAMs typically rely on lagged test scores from the previous academic year, which necessarily conflate summer learning with gains made during the school year. Such ``cross-year'' VAMs yield biased estimates of teacher effects when students with different propensities for summer learning are non-randomly assigned to classrooms, which is likely the case. We investigate the practical implications of this problem by comparing teacher effects generated by ``cross-year'' VAMs to those generated by arguably more reliable ``within-year'' VAMs using data on fall and spring test scores from the nationally representative Early Childhood Longitudinal Study -- Kindergarten Cohort (ECLS-K). We find substantive differences between ``cross-year'' and ``within-year'' VAMs that are greater for math than reading achievement. Interestingly, spring-to-spring ``cross-year'' VAMs are more reliable than fall-to-fall VAMs, though conditioning on household characteristics and children's summer activities does not significantly reduce such discrepancies. Policy implications are discussed.},
  keywords = {between students of different,closing persistent achievement gaps,demo-,graphic and socioeconomic backgrounds,is a primary goal,of education policy,summer learning loss,teacher quality,value-added models},
  file = {/Users/echenj01/Zotero/storage/GX7S2W6A/Hayes, Gershenson - 2013 - The Implications of Summer Learning Loss for Value-Added Estimates of Teacher Effectiveness.pdf}
}

